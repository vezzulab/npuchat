#!/usr/bin/env python3
# Fake FastFlowLM CLI for UI tests: list / pull / remove / serve.
# Mirrors the real `flm list --json` schema (FastFlowLM 1.0.7).
import json, os, re, sys, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

STATE = os.environ.get("MOCK_FLM_STATE", "/tmp/npu-chat-mock-installed.json")
CATALOG = {
    "llama3.2:1b": (1.3, "1B", []),
    "llama3.2:3b": (2.7, "3B", []),
    "llama3.1:8b": (5.4, "8B", []),
    "qwen3:4b": (3.1, "4B", ["reasoning", "tool-calling"]),
    "qwen3:8b": (5.6, "8B", ["reasoning", "tool-calling"]),
    "qwen3.5:9b": (8.7, "9B", ["vision", "reasoning", "tool-calling"]),
    "deepseek-r1:8b": (5.4, "8B", ["reasoning"]),
    "gpt-oss:20b": (14.0, "20B", ["reasoning"]),
    "qwen3.8-mtp:27b": (18.1, "27B", ["vision", "reasoning"]),
    "qwen3vl-flash:4b": (3.9, "4B", ["vision", "single-turn"]),
    "whisper-v3:turbo": (0.62, "1B", ["audio", "transcription"]),
    "embed-gemma:300m": (0.62, "300M", ["embeddings"]),
}

def installed():
    try:
        return json.load(open(STATE))
    except Exception:
        return ["llama3.2:1b", "qwen3:8b"]

def save(lst):
    json.dump(lst, open(STATE, "w"))

REPLY = """Una **NPU** (*Neural Processing Unit*) es un chip especializado en IA.

## Ventajas
- Consume muy poca energía
- Libera la `CPU` y la GPU

```c
int main(void) { return 0; }
```

Más info en [AMD](https://www.amd.com)."""

class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def do_GET(self):
        from urllib.parse import unquote, urlparse, parse_qs
        path = urlparse(self.path)
        if path.path.startswith("/api/rest_v1/page/summary/"):
            title = unquote(path.path.rsplit("/", 1)[1])
            if title != "Ada Lovelace":
                self.send_response(404); self.send_header("Content-Length", "0"); self.end_headers(); return
            body = json.dumps({"title": "Ada Lovelace", "description": "mathematician", "type": "standard",
                "extract": "Augusta Ada King, Countess of Lovelace was an English mathematician and writer.",
                "content_urls": {"desktop": {"page": "https://en.wikipedia.org/wiki/Ada_Lovelace"}}}).encode()
            self.send_response(200); self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body); return
        if path.path == "/w/api.php":
            body = json.dumps({"query": {"search": [{"title": "Ada Lovelace"}]}}).encode()
            self.send_response(200); self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body); return
        body = json.dumps({"object": "list", "data": [{"id": m} for m in installed()]}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def sse(self, chunks):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.end_headers()
        for c in chunks:
            self.wfile.write(f"data: {json.dumps(c)}\n\n".encode())
            self.wfile.flush()
        self.wfile.write(b"data: [DONE]\n\n")
        self.wfile.flush()

    def tools_turn(self, req, msgs):
        """Function calling, shaped like flm's: the call arrives whole, then finish_reason tool_calls."""
        last_user_at = max((i for i, m in enumerate(msgs) if m.get("role") == "user"), default=-1)
        last_user = msgs[last_user_at]["content"] if last_user_at >= 0 else ""
        # Only results that came after the newest question belong to this turn.
        tool_msgs = [m for m in msgs[last_user_at + 1:] if m.get("role") == "tool"]
        if tool_msgs:
            result = tool_msgs[-1]["content"]
            if result.startswith("Error"):
                text = "Hubo un error con la herramienta."
            elif "Wikipedia" in result:
                text = "Según Wikipedia: " + result.split("\n")[1][:60]
            elif "Battery" in result or "Memory" in result:
                text = "Tu equipo está bien."
            else:
                text = "El resultado es %s." % result
            time.sleep(0.2)
            self.sse([{"choices": [{"delta": {"content": text}}]}])
            return True
        calls = {"CALCTEST": ("calculator", {"expression": "6*7"}), "BADTOOL": ("calculator", {"expression": "1/0"}),
                 "STATUSTEST": ("system_status", {}),
                 "WIKITEST": ("wikipedia", {"topic": "Ada Lovelace"}),
                 "WIKI404": ("wikipedia", {"topic": "ada lovelace matematica"})}
        for key, (name, args) in calls.items():
            if key in last_user and req.get("tools"):
                names = [t["function"]["name"] for t in req["tools"]]
                if name not in names:
                    return False  # the skill is switched off: answer in plain text
                time.sleep(0.2)
                self.sse([
                    {"choices": [{"delta": {"tool_calls": [{"index": 0, "id": "call_1", "type": "function",
                        "function": {"name": name, "arguments": json.dumps(args)}}]}, "finish_reason": None}]},
                    {"choices": [{"delta": {"role": "assistant", "content": "\n"}, "finish_reason": None}]},
                    {"choices": [{"delta": {"content": None}, "finish_reason": "tool_calls"}]},
                ])
                return True
        return False

    def do_POST(self):
        req = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        if req.get("stream") is False:
            msgs0 = req.get("messages", [])
            sys0 = msgs0[0]["content"] if msgs0 else ""
            if "search keywords" in sys0:
                # Query expansion for document search: some synonyms of the question.
                asked = msgs0[-1]["content"]
                words = "zzzzzz" if "NOMATCH" in asked else os.environ.get("MOCK_KEYWORDS", "garantia cobertura duracion meses")
                body = json.dumps({"choices": [{"message": {"role": "assistant", "content": words}}]}).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return
            # Router question in team chats: answer with member numbers.
            route = os.environ.get("MOCK_ROUTE", "2,1")
            body = json.dumps({"choices": [{"message": {"role": "assistant", "content": route}}]}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        msgs = req.get("messages", [])
        if req.get("tools") or any(m.get("role") == "tool" for m in msgs):
            handled = self.tools_turn(req, msgs)
            if handled:
                return
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.end_headers()
        text = REPLY
        sysmsg = msgs[0]["content"] if msgs and msgs[0]["role"] == "system" else ""
        last = msgs[-1]["content"] if msgs else ""
        who = re.search(r"You are ([^,]+), one of several", sysmsg)
        if "HISTCHECK" in last:
            earlier = [m for m in msgs[:max((i for i, m in enumerate(msgs) if m.get("role") == "user"), default=0)] if m.get("role") == "tool"]
            text = "Historial con herramientas: %s; caducado: %s" % (
                "sí" if earlier else "no", "sí" if any(m["content"].startswith("(outdated") for m in earlier) else "no")
        elif "DATESYS" in last:
            text = "Contexto de hora: " + ("sí" if "[Context: it is now " in last else "no")
        elif "TOOLSYS" in last:
            text = "Instrucción de herramientas: " + ("sí" if "TOOLS:" in sysmsg and "calculator" in sysmsg else "no")
        elif "Sources:" in last and "[1]" in last:
            text = "Según tus documentos [1], la garantía cubre 24 meses."
        elif "documents attached" in last:
            text = "No encontré eso en tus documentos."
        elif "PASSTEST" in last and who and who.group(1) == "Estratega":
            text = "[PASS]"  # team member with nothing to add
        elif "TAGTEST" in last and who:
            text = "[%s]: Respuesta con etiqueta propia." % who.group(1)
        elif os.environ.get("MOCK_REPLY_FILE"):
            text = open(os.environ["MOCK_REPLY_FILE"]).read()
        elif "qwen3" in req["model"] and not who:
            text = "<think>Pienso un momento.</think>\n\n" + text
        # Defaults are fast for tests; MOCK_TTFT / MOCK_TPS mimic real NPU pacing.
        time.sleep(float(os.environ.get("MOCK_TTFT", "0.3")))
        delay = 1.0 / float(os.environ["MOCK_TPS"]) if os.environ.get("MOCK_TPS") else 0.01
        for tok in re.findall(r"\S+\s*", text):
            chunk = {"choices": [{"delta": {"content": tok}}]}
            self.wfile.write(f"data: {json.dumps(chunk)}\n\n".encode())
            self.wfile.flush()
            time.sleep(delay)
        self.wfile.write(b"data: [DONE]\n\n")
        self.wfile.flush()

cmd = sys.argv[1] if len(sys.argv) > 1 else ""
if cmd == "list":
    filt = sys.argv[sys.argv.index("--filter") + 1] if "--filter" in sys.argv else "all"
    inst = installed()
    models = []
    for name, (foot, params, labels) in CATALOG.items():
        if filt != "all" and (filt == "installed") != (name in inst):
            continue
        models.append({"name": name, "footprint": foot, "installed": name in inst,
                       "details": {"parameter_size": params}, "label": labels,
                       "size": int(float(params[:-1]) * (1e9 if params[-1] == "B" else 1e6))})
    print(json.dumps({"models": models}, indent=4))
elif cmd == "pull":
    for i in range(0, 101, 10):
        print(f"\rDownloading {sys.argv[2]}: {i}%", end="", flush=True)
        time.sleep(0.05)
    print()
    lst = installed()
    lst.append(sys.argv[2])
    save(lst)
elif cmd == "remove":
    sys.stdin.readline()
    save([m for m in installed() if m != sys.argv[2]])
    print("removed")
elif cmd == "serve":
    print(f"Loading {sys.argv[2]}...", flush=True)
    time.sleep(0.5)
    port = int(sys.argv[sys.argv.index("--port") + 1]) if "--port" in sys.argv else 52625
    ThreadingHTTPServer(("127.0.0.1", port), H).serve_forever()
