#!/usr/bin/env python3
# Fake FastFlowLM CLI for UI tests: list / pull / remove / serve.
# Mirrors the real `flm list --json` schema (FastFlowLM 1.0.7).
import json, os, re, sys, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

STATE = os.environ.get("MOCK_FLM_STATE", "/tmp/npu-chat-mock-installed.json")
CATALOG = {
    "llama3.2:1b": (1.3, "1B", []),
    "llama3.2:3b": (2.7, "3B", []),
    "llama3.1:8b": (5.4, "8B", []),
    "qwen3:4b": (3.1, "4B", ["reasoning", "tool-calling"]),
    "qwen3:8b": (5.6, "8B", ["reasoning", "tool-calling"]),
    "qwen3.5:9b": (8.7, "9B", ["vision", "reasoning", "tool-calling"]),
    "deepseek-r1:8b": (5.4, "8B", ["reasoning"]),
    "gpt-oss:20b": (14.0, "20B", ["reasoning"]),
    "qwen3.8-mtp:27b": (18.1, "27B", ["vision", "reasoning"]),
    "qwen3vl-flash:4b": (3.9, "4B", ["vision", "single-turn"]),
    "whisper-v3:turbo": (0.62, "1B", ["audio", "transcription"]),
    "embed-gemma:300m": (0.62, "300M", ["embeddings"]),
}

def installed():
    try:
        return json.load(open(STATE))
    except Exception:
        return ["llama3.2:1b", "qwen3:8b"]

def save(lst):
    json.dump(lst, open(STATE, "w"))

REPLY = """Una **NPU** (*Neural Processing Unit*) es un chip especializado en IA.

## Ventajas
- Consume muy poca energía
- Libera la `CPU` y la GPU

```c
int main(void) { return 0; }
```

Más info en [AMD](https://www.amd.com)."""

class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def do_GET(self):
        body = json.dumps({"object": "list", "data": [{"id": m} for m in installed()]}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        req = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.end_headers()
        text = REPLY
        if os.environ.get("MOCK_REPLY_FILE"):
            text = open(os.environ["MOCK_REPLY_FILE"]).read()
        elif "qwen3" in req["model"]:
            text = "<think>Pienso un momento.</think>\n\n" + text
        # Defaults are fast for tests; MOCK_TTFT / MOCK_TPS mimic real NPU pacing.
        time.sleep(float(os.environ.get("MOCK_TTFT", "0.3")))
        delay = 1.0 / float(os.environ["MOCK_TPS"]) if os.environ.get("MOCK_TPS") else 0.01
        for tok in re.findall(r"\S+\s*", text):
            chunk = {"choices": [{"delta": {"content": tok}}]}
            self.wfile.write(f"data: {json.dumps(chunk)}\n\n".encode())
            self.wfile.flush()
            time.sleep(delay)
        self.wfile.write(b"data: [DONE]\n\n")
        self.wfile.flush()

cmd = sys.argv[1] if len(sys.argv) > 1 else ""
if cmd == "list":
    filt = sys.argv[sys.argv.index("--filter") + 1] if "--filter" in sys.argv else "all"
    inst = installed()
    models = []
    for name, (foot, params, labels) in CATALOG.items():
        if filt != "all" and (filt == "installed") != (name in inst):
            continue
        models.append({"name": name, "footprint": foot, "installed": name in inst,
                       "details": {"parameter_size": params}, "label": labels,
                       "size": int(float(params[:-1]) * (1e9 if params[-1] == "B" else 1e6))})
    print(json.dumps({"models": models}, indent=4))
elif cmd == "pull":
    for i in range(0, 101, 10):
        print(f"\rDownloading {sys.argv[2]}: {i}%", end="", flush=True)
        time.sleep(0.05)
    print()
    lst = installed()
    lst.append(sys.argv[2])
    save(lst)
elif cmd == "remove":
    sys.stdin.readline()
    save([m for m in installed() if m != sys.argv[2]])
    print("removed")
elif cmd == "serve":
    print(f"Loading {sys.argv[2]}...", flush=True)
    time.sleep(0.5)
    port = int(sys.argv[sys.argv.index("--port") + 1]) if "--port" in sys.argv else 52625
    ThreadingHTTPServer(("127.0.0.1", port), H).serve_forever()
